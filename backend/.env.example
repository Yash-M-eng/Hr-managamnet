# ACME Salary Management System - Backend Environment Configuration

# 1. Server Configuration
PORT=4000
WEB_ORIGIN="http://localhost:3000"

# 2. Database Configuration (Prisma SQLite)
# For SQLite, the path is relative to the prisma/ directory
DATABASE_URL="file:./dev.db"

# 3. Authentication & Security
# Provide a secure random secret key in production
JWT_SECRET="acme-salary-super-secret-jwt-key-2026-production"

# 4. Google Gemini AI Configuration (Free Tier Supported)
# Get your free API key at: https://aistudio.google.com/
# NOTE: If left empty or quota is exhausted (HTTP 429), the system automatically
# falls back to the built-in deterministic SQL query engine!
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
DEMO_HR_EMAIL=hr.manager@acme.corp
DEMO_HR_PASSWORD=AcmeHR2026!Secure